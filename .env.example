# Realtime ReID runtime configuration
#
# Copy this file once with:
#   scripts/reidctl.sh init
#
# Keep .env private. It may contain camera URLs and device-specific paths.

# Device role: prime or worker
PIPELINE_ROLE=prime
# A prime can also run a camera worker on the same device.
LOCAL_CAMERA_ENABLED=true

# Python runtime selection. Leave PYTHON_BIN and CONDA_ENV empty on Jetson to
# use .venv-jetson. For a workstation, set CONDA_ENV to the environment name.
PYTHON_BIN=
JETSON_VENV=.venv-jetson
CONDA_ENV=

# Optional config-file overrides. Empty values use the correct role defaults.
CONFIG_DIR=configs
REALTIME_CONFIG=
YOLO_CONFIG=
YOLOE_CONFIG=
REID_CONFIG=
TRACKER_CONFIG=
PIPELINE_CONFIG=
MODEL_MANIFEST=deploy/model_manifest.yaml

# Prime network endpoint
# On a separate worker, replace 127.0.0.1 with the prime device's LAN address.
PRIME_URL=ws://127.0.0.1:8765
# A separate worker must use the prime's LAN address. Keep false in production.
ALLOW_LOOPBACK_PRIME=false
PRIME_BIND_HOST=0.0.0.0
PRIME_PORT=8765
INGEST_PATH=/ws/ingest
VIEWER_PATH=/ws/view

# Camera assignment for this device
# Keep IDs globally unique. With automatic USB scanning, leave CAMERA_SOURCES
# empty. For fixed devices or RTSP, set CAMERA_AUTO_SCAN=false and provide the
# same number of comma-separated sources as IDs.
# Quote CAMERA_SOURCES when an RTSP URL contains shell characters such as
# '&' or '#'. Credentials stay only in the ignored .env file.
CAMERA_IDS=cam1
CAMERA_SOURCES=
CAMERA_AUTO_SCAN=true
CAMERA_START_ON_LAUNCH=true
CAMERA_AUTO_START_RETRY_SECONDS=5
CAMERA_SOURCE=
CAMERA_TARGET_FPS=10
CAMERA_CAPTURE_WIDTH=640
CAMERA_CAPTURE_HEIGHT=480
CAMERA_CAPTURE_FPS=10
CAMERA_RECONNECT_SECONDS=3
CAMERA_PRINT_EVERY_FRAMES=100
FRAME_JPEG_QUALITY=70
CROP_JPEG_QUALITY=85

# Worker control API and dashboard nodes
WORKER_CONTROL_BIND_HOST=0.0.0.0
WORKER_CONTROL_PORT=8787
# Syntax: name=http://host:port,name2=http://host:port
WORKER_NODES=local=http://127.0.0.1:8787

# YOLO detector
YOLO_MODEL_PATH=yolo26m.pt
YOLO_DEVICE=cuda:0
YOLO_REQUIRE_GPU=true
YOLO_CONFIDENCE=0.50
YOLO_IOU_THRESHOLD=0.70
YOLO_IMGSZ=640
YOLO_HALF=true
YOLO_MAX_DETECTIONS=50

# Generalized ReID model, used only by the prime
REID_BACKEND=onnxruntime_direct
REID_MODEL_PATH=~/TwinProject_models/reid_generalized_yolo11n/generalized_reid_swin_epoch119.onnx
REID_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
REID_ALLOW_CPU_FALLBACK=false
REID_REQUIRE_GPU=true
REID_INPUT_HEIGHT=256
REID_INPUT_WIDTH=128
REID_EMBEDDING_DIM=1024
REID_BATCH_SIZE=4
REID_MAX_BATCH_SIZE=4

# Local tracker
TRACKER_DEVICE=cuda:0
TRACKER_FP16=true
TRACKER_BUFFER_FRAMES=30
TRACKER_MATCH_THRESHOLD=0.80
TRACKER_APPEARANCE_THRESHOLD=0.30
TRACKER_PROXIMITY_THRESHOLD=0.50

# Prime output and dashboard
REALTIME_OUTPUT_DIR=outputs/realtime
SAVE_VIDEO=true
OUTPUT_FPS=10
RECORDING_SEGMENT_SECONDS=900
RECORDING_MIN_FREE_GB=5
RECORDING_DISK_CHECK_SECONDS=10
# Set both values when recordings must stay on a dedicated mounted disk.
RECORDING_MOUNTPOINT=
VIEWER_JPEG_QUALITY=75
VIEWER_SEND_TIMEOUT_SECONDS=0.2
CAMERA_OFFLINE_SECONDS=5
MAX_QUEUE_SIZE=16
CLIENT_MAX_SIZE_MB=32
SYNC_BATCH_WINDOW_MS=25
SYNC_BATCH_MAX_PACKETS=4
MAX_CAPTURE_CLOCK_SKEW_SECONDS=5
CAMERA_TRACKER_RESET_SECONDS=3

# Global ReID policy
GLOBAL_MATCH_THRESHOLD=0.30
GALLERY_TTL_SECONDS=300
GALLERY_EMA_ALPHA=0.80
GALLERY_MAX_EXEMPLARS=8
NEW_IDENTITY_MIN_FRAMES=5
NEW_IDENTITY_MIN_SECONDS=0.4
NEW_TRACK_MATCH_THRESHOLD=0.30
IDENTITY_MIN_CONFIDENCE=0.55
CROSS_CAMERA_EXCLUSION_SECONDS=1.0
DEBUG_REID=false
SAVE_DEBUG_CROPS=false

# Physical camera topology
# Pair syntax: cam1:cam2,cam3:cam4
ALLOW_ALL_CAMERA_OVERLAP=false
OVERLAPPING_CAMERA_PAIRS=
ADJACENT_CAMERA_PAIRS=

# Startup behavior
RUNTIME_LOG_DIR=outputs
STARTUP_SMOKE_TEST=true
SMOKE_LOAD_MODELS=false
