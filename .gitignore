# Keep directory structure but ignore contents
!.gitkeep

# Keep example configs and small test files
!configs/*.yaml
!scripts/*.py
!scripts/*.sh

# Keep README and documentation
!README.md
!*.md
!docs/**/*.md

# Keep small sample data if any
!test_videos/.gitkeep

# Docker
.dockerignore
docker-compose.override.yml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Profiling
*.prof
*.lprof
