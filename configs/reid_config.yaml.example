# Example: How to configure for a new model

# For ONNX model:
triton:
  server_url: "localhost:8100"
  model_name: "new_reid"        # Change this
  model_version: "1"

model:
  onnx_path: "models/new_reid_model.onnx"
  input_shape: [384, 192]       # Adjust if different
  embedding_dim: 256            # Adjust if different

preprocessing:
  mean: [0.485, 0.456, 0.406]  # Check model's training normalization
  std: [0.229, 0.224, 0.225]

tensorrt:
  min_batch: 1
  opt_batch: 8
  max_batch: 16
  precision: "fp16"

# For TensorRT model:
# triton:
#   model_name: "new_reid_trt"   # Point to TensorRT version
