# Optional per-device overrides loaded by the systemd user services.
# Keep large model binaries outside Git and uncomment absolute paths here.

# Prime device only:
# REID_MODEL_PATH=${HOME}/TwinProject_models/reid_generalized_yolo11n/generalized_reid_swin_epoch119.onnx
# REALTIME_OUTPUT_DIR=/mnt/recordings/reid
# RECORDING_MOUNTPOINT=/mnt/recordings
# RECORDING_MIN_FREE_GB=5

# Every device that runs a camera worker:
# YOLO_MODEL_PATH=${HOME}/TwinProject_models/reid_generalized_yolo11n/yolo26m.pt

# Worker devices can override the YAML endpoint without editing tracked files:
# Replace the documentation-only address with the prime device's LAN address.
# PRIME_URL=ws://192.0.2.10:8765
